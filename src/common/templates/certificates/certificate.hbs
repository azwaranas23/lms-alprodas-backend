<html lang='id'>

<head>
  <meta charset='UTF-8' />
  <title>Sertifikat Penyelesaian Kelas</title>
  <style>
    @page {
      size: A4 landscape;
      margin: 0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      width: 297mm;
      height: 210mm;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #f8fbf7;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #26301f;
      line-height: 1.2;
    }

    .certificate {
      position: relative;
      width: 297mm;
      height: 210mm;
      padding: 18mm 23mm;
      background:
        radial-gradient(circle at top left, rgba(51, 94, 247, 0.08), transparent 28%),
        radial-gradient(circle at bottom right, rgba(212, 175, 55, 0.14), transparent 30%),
        linear-gradient(135deg, #ffffff 0%, #fbfdf8 55%, #f6faf2 100%);
    }

    .outer-border {
      position: absolute;
      inset: 7mm;
      border: 2.6px dashed #1f3b13;
      border-radius: 2mm;
      pointer-events: none;
    }

    .inner-border {
      position: absolute;
      inset: 13mm;
      border: 1px solid rgba(31, 59, 19, 0.28);
      border-radius: 1.5mm;
      pointer-events: none;
    }

    .corner {
      position: absolute;
      width: 26mm;
      height: 26mm;
      border-color: #d4af37;
      opacity: 0.85;
    }

    .corner.tl {
      left: 15mm;
      top: 15mm;
      border-left: 3px solid #d4af37;
      border-top: 3px solid #d4af37;
    }

    .corner.tr {
      right: 15mm;
      top: 15mm;
      border-right: 3px solid #d4af37;
      border-top: 3px solid #d4af37;
    }

    .corner.bl {
      left: 15mm;
      bottom: 15mm;
      border-left: 3px solid #d4af37;
      border-bottom: 3px solid #d4af37;
    }

    .corner.br {
      right: 15mm;
      bottom: 15mm;
      border-right: 3px solid #d4af37;
      border-bottom: 3px solid #d4af37;
    }

    .content {
      position: relative;
      z-index: 2;
      height: 100%;
      text-align: center;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 2mm;
      margin-bottom: 9mm;
    }

    .brand-logo {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, #242857 0%, #335ef7 70%, #33bcf7 100%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: middle;
    }

    .brand-logo svg {
      width: 20px;
      height: 20px;
      color: #ffffff;
    }

    .brand-text {
      text-align: left;
      color: #1f3b13;
    }

    .brand-name {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.4px;
    }

    .brand-subtitle {
      font-size: 9px;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      color: #6b7280;
      margin-top: 2px;
    }

    .cert-title {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 40px;
      font-weight: 500;
      color: #1f3b13;
      letter-spacing: 0.4px;
      margin-bottom: 8mm;
    }

    .cert-subtitle {
      font-size: 15px;
      color: #4b5563;
      margin-bottom: 6mm;
    }

    .student-name {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 52px;
      line-height: 1.05;
      font-weight: 700;
      color: #1f3b13;
      letter-spacing: 4px;
      text-transform: uppercase;
      max-width: 235mm;
      margin: 0 auto 7mm auto;
      word-break: break-word;
    }

    .ornament {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin: 0 auto 6mm auto;
    }

    .ornament .line {
      width: 46mm;
      height: 1px;
      background: linear-gradient(to right, transparent, #d4af37, transparent);
    }

    .ornament .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #d4af37;
      box-shadow: 14px 0 0 rgba(212, 175, 55, 0.45), -14px 0 0 rgba(212, 175, 55, 0.45);
    }

    .completion-text {
      font-size: 15px;
      color: #4b5563;
      margin-bottom: 3mm;
    }

    .course-name {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 25px;
      font-weight: 700;
      color: #242857;
      max-width: 220mm;
      margin: 0 auto 7mm auto;
      line-height: 1.25;
    }

    .meta-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12mm;
      margin-bottom: 6mm;
      color: #374151;
      font-size: 13px;
    }

    .meta-item span {
      font-weight: 700;
      color: #1f3b13;
    }

    .footer {
      position: absolute;
      left: 24mm;
      right: 24mm;
      bottom: 18mm;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
    }

    .footer-col {
      width: 62mm;
      text-align: center;
      color: #2f3728;
    }

    .footer-line {
      width: 54mm;
      height: 1px;
      background: #b8b8b8;
      margin: 0 auto 4px auto;
    }

    .footer-name {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 17px;
      color: #1f2937;
      font-weight: 600;
    }

    .footer-title {
      font-size: 10px;
      color: #6b7280;
      margin-top: 2px;
    }

    .seal-wrap {
      width: 52mm;
      text-align: center;
      margin-bottom: 1mm;
    }

    .seal {
      position: relative;
      width: 23mm;
      height: 23mm;
      border-radius: 50%;
      margin: 0 auto 4px auto;
      background:
        radial-gradient(circle, #f7dc79 0%, #e9bd3b 58%, #b8860b 100%);
      border: 2px solid #b8860b;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.14);
      color: #1f3b13;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 7.5px;
      font-weight: 800;
      letter-spacing: 0.3px;
      line-height: 1.05;
    }

    .seal::before {
      content: '';
      position: absolute;
      inset: 3px;
      border: 1px dashed rgba(31, 59, 19, 0.55);
      border-radius: 50%;
    }

    .seal-ribbon {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 43mm;
      height: 8mm;
      transform: translate(-50%, -50%);
      background: #1f3b13;
      z-index: -1;
      clip-path: polygon(0 0, 12% 50%, 0 100%, 100% 100%, 88% 50%, 100% 0);
    }

    .seal-label {
      font-size: 12px;
      font-weight: 700;
      color: #1f3b13;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-top: 2px;
    }

    .seal-note {
      font-size: 8.5px;
      line-height: 1.2;
      color: #6b7280;
      max-width: 55mm;
      margin: 2px auto 0 auto;
    }

    .signature-block {
      margin-bottom: 4px;
      min-height: 20mm;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .signature-block svg {
      width: 50mm !important;
      height: auto !important;
      max-height: 19mm;
      display: block;
      margin: 0 auto -2px auto;
    }

    .verification {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 6mm;
      text-align: center;
      font-size: 8.5px;
      color: #8a8f98;
      letter-spacing: 0.2px;
    }
  </style>
</head>

<body>
  <div class='certificate'>
    <div class='outer-border'></div>
    <div class='inner-border'></div>
    <div class='corner tl'></div>
    <div class='corner tr'></div>
    <div class='corner bl'></div>
    <div class='corner br'></div>

    <main class='content'>
      <header class='brand'>
        <div class='brand-logo'>
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'
            stroke-linecap='round' stroke-linejoin='round'>
            <path
              d='M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z'>
            </path>
            <path d='M22 10v6'></path>
            <path d='M6 12.5V16a6 3 0 0 0 12 0v-3.5'></path>
          </svg>
        </div>
        <div class='brand-text'>
          <div class='brand-name'>Alprodas LMS</div>
          <div class='brand-subtitle'>Learning Management System</div>
        </div>
      </header>

      <section>
        <h1 class='cert-title'>Sertifikat Penyelesaian</h1>
        <p class='cert-subtitle'>Sertifikat ini dengan bangga diberikan kepada</p>

        <div class='student-name'>{{studentName}}</div>

        <div class='ornament'>
          <span class='line'></span>
          <span class='dot'></span>
          <span class='line'></span>
        </div>

        <p class='completion-text'>Telah menyelesaikan dengan baik kelas</p>
        <div class='course-name'>“{{courseName}}”</div>

        <div class='meta-row'>
          <div class='meta-item'>Tanggal selesai: <span>{{completedDate}}</span></div>
          <div class='meta-item'>Kode verifikasi: <span>{{certificateId}}</span></div>
        </div>
      </section>

      <footer class='footer'>
        <div class='footer-col'>
          <div class='footer-line'></div>
          <div class='footer-name'>Alprodas LMS</div>
          <div class='footer-title'>Media Pembelajaran E-learning</div>
        </div>

        <div class='seal-wrap'>
          <div class='seal'>
            <div class='seal-ribbon'></div>
            RESMI<br />TERVERIFIKASI
          </div>
          <div class='seal-label'>Verified</div>
          <div class='seal-note'>Sertifikat ini diterbitkan secara otomatis oleh sistem Alprodas LMS.</div>
        </div>

        <div class='footer-col'>
          <div class='signature-block'>
            <svg class="signature-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
              width="158" height="64" viewBox="0 0 500 150" fill="none">
              <image width="500" height="150" preserveAspectRatio="xMidYMid meet"
                href="data:image/png;base64,"
                xlink:href="data:image/png;base64," />
            </svg>
          </div>
          <div class='footer-line'></div>
          <div class='footer-name'>Azwar Anas</div>
          <div class='footer-title'>Pengembang Alprodas LMS</div>
        </div>
      </footer>
    </main>

    <div class='verification'>
      Verifikasi sertifikat menggunakan kode: {{certificateId}}
    </div>
  </div>
</body>

</html>